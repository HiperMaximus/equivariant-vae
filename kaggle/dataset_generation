    "# --- CONFIGURATION ---\n",
    "MODE = 'valid' # 'train' or 'valid'     \n",
    "PART_ID = 5 # 0...5        \n",
    "TOTAL_PARTS = 6         \n",
    "\n",
    "if MODE == 'valid':\n",
