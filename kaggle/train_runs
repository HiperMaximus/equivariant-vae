-> torch.Tensor:\n        if self.f is None:\n            self.f = open(self.bin_path, \"rb\")\n            \n        seek_pos = self.HEADER_SIZE + (idx * self.PATCH_SIZE)\n        self.f.seek(seek_pos)\n        raw_bytes = self.f.read(self.PATCH_SIZE)\n        \n        # Reshape is strictly required to define the 3D tensor bounds.\n        # Copy is required because frombuffer yields a read-only view.\n        image_np = np.frombuffer(raw_bytes, dtype=np.uint8).reshape(self.C, self.H, self.W).copy()\n        \n        # Return uint8 tensor. Scaling is deferred to the GPU.\n        return torch.from_numpy(image_np)\n\n    def __del__(self):\n        if self.f is None:\n            pass\n        elif hasattr(self.f, 'closed') and not self.f.closed:\n            self.f.close()\n\ndef get_dataloaders(\n    train_bin: str, train_csv: str, \n    val_bin: str, val_csv: str, \n    batch_size: int, num_workers: int = 3\n) -> tuple[DataLoader, DataLoader]:\n    \n    train_ds = UBCDataset(train_bin, train_csv)\n    val_ds = UBCDataset(val_bin, val_csv)\n    \n    # Shuffle is False due to already pre-shuffled binary structures.\n    # pin_memory=True allocates page-locked memory for accelerated PCIe transfer.\n    train_loader = DataLoader(\n        train_ds, batch_size=batch_size, shuffle=False, \n        num_workers=num_workers, pin_memory=True, drop_last=True\n    )\n    \n    val_loader = DataLoader(\n        val_ds, batch_size=batch_size, shuffle=False, \n        num_workers=num_workers, pin_memory=True, drop_last=False\n    )\n    \n    return train_loader, val_loader","metadata":{"trusted":true},"outputs":[],"execution_count":null},{"cell_type":"code","source":"def configure_amp_hardware(device: torch.device) -> tuple[bool, torch.dtype]:\n    \"\"\"\n    Evaluates CUDA compute capability to determine optimal AMP settings.\n    Returns: (amp_enabled, optimal_dtype)\n    \"\"\"\n    if device.type != 'cuda':\n        return False, torch.float32\n        \n    major, minor = torch.cuda.get_device_capability(device)\n    \n    # 1. Pascal (e.g., Kaggle P100) or older\n    if major < 7:\n        print(\"Hardware Warning: Compute Capability < 7.0. Tensor Cores absent. AMP disabled.\")\n        return False, torch.float32\n        \n    # 2. Ampere (e.g., Kaggle A100) or newer\n    if major >= 8:\n        print(\"Hardware Optimal: Compute Capability >= 8.0. Utilizing bfloat16 AMP.\")\n        return True, torch.bfloat16\n        \n    # 3. Turing/Volta (e.g., Kaggle T4, V100)\n    print(\"Hardware Capable: Compute Capability 7.x. Utilizing float16 AMP.\")\n    return True, torch.float16","metadata":{"trusted":true},"outputs":[],"execution_count":null},{"cell_type":"code","source":"def train_epoch(\n    model: nn.Module, \n    dataloader: torch.utils.data.DataLoader, \n    optimizer: torch.optim.Optimizer, \n    scaler: Optional[torch.amp.GradScaler],\n    criterion: nn.Module,\n    corruptor: nn.Module,\n    device: torch.device,\n    amp_enabled: bool,\n    amp_dtype: torch.dtype,\n    corruption_ratio: float = 0.80\n) -> float:\n    \n    model.train()\n    epoch_loss = 0.0\n    \n    for batch_idx, images_uint8 in enumerate(dataloader):\n        images_device = images_uint8.to(device, non_blocking=True)\n        x_clean = (images_device.to(torch.float32) / 255.0) * 2.0 - 1.0\n        \n        B = x_clean.shape[0]\n        n_corrupt = int(corruption_ratio * B)\n        x_in = x_clean.clone()\n        \n        if n_corrupt > 0:\n            x_in[:n_corrupt] = corruptor(x_clean[:n_corrupt])\n        \n        optimizer.zero_grad(set_to_none=True)\n        \n        # Dynamically apply AMP context\n        with torch.amp.autocast('cuda', enabled=amp_enabled, dtype=amp_dtype):\n            recon_images, z_q = model(x_in)\n            total_loss = criterion(recon_images, x_clean)\n            \n        # Optimization step logic branching based on scalar presence\n        if scaler is not None and amp_dtype == torch.float16:\n            scaler.scale(total_loss).backward()\n            scaler.unscale_(optimizer)\n            torch.nn.utils.clip_grad_norm_(model.parameters(), max_norm=1.0)\n            scaler.step(optimizer)\n            scaler.update()\n        else:\n            total_loss.backward()\n            torch.nn.utils.clip_grad_norm_(model.parameters(), max_norm=1.0)\n            optimizer.step()\n        \n        epoch_loss += total_loss.item()\n        \n    return epoch_loss / len(dataloader)","metadata":{"trusted":true},"outputs":[],"execution_count":null},{"cell_type":"code","source":"import torch\nimport torch.nn as nn\nfrom torch import Tensor\n\nclass HistopathologyCorruptor(nn.Module):\n    \"\"\"\n    Executes a physically grounded, asymmetric H&E stain perturbation model.\n    Transforms sRGB inputs to Linear RGB, projects to natural log (ln) Optical Density, \n    applies isolated affine stain jitter, and reconstructs the sRGB tensor.\n    \n    Expects input tensors strictly in the domain [-1, 1].\n    \"\"\"\n    def __init__(self, noise_std: float = 0.01) -> None:\n        super().__init__()\n        self.noise_std = noise_std\n        \n        # 1. Standard skimage rgb_from_hed matrix (normalized OD absorption vectors)\n        rgb_from_hed = torch.tensor([\n            [0.650, 0.704, 0.286],\n            [0.072, 0.990, 0.105],\n            [0.268, 0.570, 0.776]\n        ], dtype=torch.float32)\n        \n        hed_from_rgb = torch.linalg.inv(rgb_from_hed)\n        self.register_buffer(\"hed_from_rgb\", hed_from_rgb)\n        self.register_buffer(\"rgb_from_hed\", rgb_from_hed)\n\n        # 2. Asymmetric Variance Bounds [Hematoxylin, Eosin, Residual/DAB]\n        # Hematoxylin (nuclear) exhibits higher variance due to bath duration sensitivity.\n        # Residual channel is granted micro-variance to prevent illumination shortcut learning.\n        alpha_min = torch.tensor([0.80, 0.85, 0.98], dtype=torch.float32).view(1, 3, 1, 1)\n        alpha_max = torch.tensor([1.25, 1.20, 1.02], dtype=torch.float32).view(1, 3, 1, 1)\n        \n        beta_min = torch.tensor([-0.05, -0.03, -0.01], dtype=torch.float32).view(1, 3, 1, 1)\n        beta_max = torch.tensor([ 0.05,  0.03,  0.01], dtype=torch.float32).view(1, 3, 1, 1)\n        \n        self.register_buffer(\"alpha_min\", alpha_min)\n        self.register_buffer(\"alpha_max\", alpha_max)\n        self.register_buffer(\"beta_min\", beta_min)\n        self.register_buffer(\"beta_max\", beta_max)\n\n    @staticmethod\n    def _srgb_to_linear(x: Tensor) -> Tensor:\n        \"\"\"Exact piecewise IEC 61966-2-1 transformation: sRGB -> Linear RGB\"\"\"\n        return torch.where(\n            x <= 0.04045,\n            x / 12.92,\n            torch.pow(torch.clamp((x + 0.055) / 1.055, min=1e-8), 2.4)\n        )\n\n    @staticmethod\n    def _linear_to_srgb(x: Tensor) -> Tensor:\n        \"\"\"Exact piecewise IEC 61966-2-1 transformation: Linear RGB -> sRGB\"\"\"\n        return torch.where(\n            x <= 0.0031308,\n            x * 12.92,\n            1.055 * torch.pow(torch.clamp(x, min=1e-8), 1.0 / 2.4) - 0.055\n        )\n\n    def _apply_hed_jitter(self, x: Tensor) -> Tensor:\n        # Step 1: Shift [-1, 1] input tensor to standard [0, 1] color range\n        x_01 = (x + 1.0) / 2.0\n        \n        # Step 2: Recover physical light transmittance (Linear RGB)\n        x_linear = self._srgb_to_linear(x_01)\n        \n        # Step 3: Compute Optical Density (Beer-Lambert Law) using natural log\n        od = -torch.log(torch.clamp(x_linear, min=1e-8))\n        \n        # Step 4: Clip OD to physical sensor noise floor (~5% transmittance limit)\n        od = torch.clamp(od, min=0.0, max=3.0)\n        \n        # Step 5: Linear Deconvolution to Stain Concentrations (HED)\n        hed = torch.einsum('ij, b j h w -> b i h w', self.hed_from_rgb, od)\n        \n        # Step 6: Generate physical augmentation parameters\n        B = x.shape[0]\n        device = x.device\n        \n        rand_alpha = torch.rand(B, 3, 1, 1, device=device, dtype=torch.float32)\n        alpha = self.alpha_min + rand_alpha * (self.alpha_max - self.alpha_min)\n        \n        rand_beta = torch.rand(B, 3, 1, 1, device=device, dtype=torch.float32)\n        beta = self.beta_min + rand_beta * (self.beta_max - self.beta_min)\n        \n        # Step 7: Apply Affine Perturbation in isolated concentration space\n        hed_aug = (hed * alpha) + beta\n        \n        # Step 8: Reconstruct Augmented Optical Density\n        od_aug = torch.einsum('ij, b j h w -> b i h w', self.rgb_from_hed, hed_aug)\n        od_aug = torch.clamp(od_aug, min=0.0, max=3.0)\n        \n        # Step 9: Reconstruct Transmittance (Inverse Natural Log)\n        x_aug_linear = torch.exp(-od_aug)\n        \n        # Step 10: Apply standard display gamma compression\n        x_aug_01 = self._linear_to_srgb(x_aug_linear)\n        \n        # Step 11: Return tensor to the network's expected [-1, 1] bounds\n        x_aug = (x_aug_01 * 2.0) - 1.0\n        return torch.clamp(x_aug, min=-1.0, max=1.0)\n\n    def forward(self, x: Tensor) -> Tensor:\n        \"\"\"\n        Executes the jitter pipeline and injects optional Gaussian sensor noise.\n        Maintains FP32 precision strictly within the computational block.\n        \"\"\"\n        with torch.no_grad():\n            original_dtype = x.dtype\n            x_fp32 = x.to(torch.float32)\n            \n            x_corrupted = self._apply_hed_jitter(x_fp32)\n            \n            if self.noise_std > 0:\n                noise = torch.randn_like(x_corrupted) * self.noise_std\n                x_corrupted = x_corrupted + noise\n                \n            x_corrupted = torch.clamp(x_corrupted, min=-1.0, max=1.0)\n            return x_corrupted.to(original_dtype)","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-02-26T03:28:46.185959Z","iopub.execute_input":"2026-02-26T03:28:46.186457Z","iopub.status.idle":"2026-02-26T03:28:46.97