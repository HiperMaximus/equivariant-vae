        g /= g.sum()\n        \n        kernel_2d = (g.unsqueeze(0) * g.unsqueeze(1)).expand(channels, 1, window_size, window_size).contiguous()\n        self.register_buffer(\"kernel\", kernel_2d)\n        self.groups = channels\n        self.pad = window_size // 2\n\n    def forward(self, pred: torch.Tensor, target: torch.Tensor) -> torch.Tensor:\n        # Reflection padding maintains strict gradients at patch boundaries\n        pred = F.pad(pred, (self.pad, self.pad, self.pad, self.pad), mode=\"reflect\")\n        target = F.pad(target, (self.pad, self.pad, self.pad, self.pad), mode=\"reflect\")\n        \n        mu1 = F.conv2d(pred, self.kernel, groups=self.groups)\n        mu2 = F.conv2d(target, self.kernel, groups=self.groups)\n        mu1_sq, mu2_sq, mu1_mu2 = mu1 ** 2, mu2 ** 2, mu1 * mu2\n        \n        # Unconstrained variance calculation to match baseline mathematical formulas\n        sigma1_sq = F.conv2d(pred * pred, self.kernel, groups=self.groups) - mu1_sq\n        sigma2_sq = F.conv2d(target * target, self.kernel, groups=self.groups) - mu2_sq\n        sigma12 = F.conv2d(pred * target, self.kernel, groups=self.groups) - mu1_mu2\n        \n        num = (2 * mu1_mu2 + self.C1) * (2 * sigma12 + self.C2)\n        den = (mu1_sq + mu2_sq + self.C1) * (sigma1_sq + sigma2_sq + self.C2)\n        return (num / den).mean()\n\nclass CombinedReconstructionLoss(nn.Module):\n    def __init__(self, ssim_weight: float = 0.1):\n        super().__init__()\n        self.charbonnier = CharbonnierLoss()\n        self.ssim_metric = StatelessSSIM(data_range=2.0, channels=3)\n        self.ssim_weight = ssim_weight\n\n    def forward(self, pred: torch.Tensor, target: torch.Tensor) -> tuple[torch.Tensor, torch.Tensor, torch.Tensor]:\n        loss_c = self.charbonnier(pred, target)\n        loss_s = 1.0 - self.ssim_metric(pred, target)\n        return loss_c + (self.ssim_weight * loss_s), loss_c, loss_s\n\n# ==========================================\n# 5. EMA & State Management\n# ==========================================\nclass EMA:\n    \"\"\"Detached FP32 moving average executed strictly outside the autograd graph.\"\"\"\n    def __init__(self, model: nn.Module, decay: float = 0.999):\n        self.decay = decay\n        self.shadow = {}\n        for name, param in model.named_parameters():\n            if param.requires_grad:\n                self.shadow[name] = param.data.clone().detach().to(torch.float32)\n\n    @torch.no_grad()\n    def update(self, model: nn.Module):\n        for name, param in model.named_parameters():\n            if param.requires_grad:\n                self.shadow[name].mul_(self.decay).add_(param.data.to(torch.float32), alpha=1.0 - self.decay)\n\n    def copy_to(self, model: nn.Module):\n        for name, param in model.named_parameters():\n            if param.requires_grad:\n                param.data.copy_(self.shadow[name])\n\ndef save_checkpoint(model, ema, optimizer, scaler, epoch, step, best_loss, filepath):\n    state = {\n        'epoch': epoch,\n        'step': step,\n        'best_loss': best_loss,\n        'model': model.module.state_dict(),\n        'ema_state': ema.shadow,\n        'optimizer': optimizer.state_dict(),\n        'scaler': scaler.state_dict(),\n        'rng_state': torch.get_rng_state(),\n        'cuda_rng_state': torch.cuda.get_rng_state_all(),\n        'np_rng_state': np.random.get_state()\n    }\n    # Protocol 5 utilizes out-of-band data to prevent memory duplication spikes\n    torch.save(state, filepath, pickle_protocol=5)\n\ndef load_checkpoint(filepath, model, ema, optimizer, scaler, device):\n    print(f\"Loading checkpoint: {filepath}\")\n    state = torch.load(filepath, map_location=device, weights_only=False)\n    \n    model.module.load_state_dict(state['model'])\n    ema.shadow = state['ema_state']\n    optimizer.load_state_dict(state['optimizer'])\n    scaler.load_state_dict(state['scaler'])\n    \n    torch.set_rng_state(state['rng_state'])\n    torch.cuda.set_rng_state_all(state['cuda_rng_state'])\n    np.random.set_state(state['np_rng_state'])\n    \n    return state['epoch'], state['step'], state['best_loss']\n\ndef get_parameter_groups(model, weight_decay: float = 1e-5):\n    \"\"\"\n    Isolates explicit biases, normalization scalars, and FSQ standard deviations \n    from L2 decay to prevent continuous manifold collapse.\n    \"\"\"\n    decay, no_decay = [], []\n    for name, param in model.named_parameters():\n        if not param.requires_grad: continue\n        # s_raw has ndim=4, so explicit string isolation is strictly required\n        if param.ndim <= 1 or name.endswith(\".bias\") or \"s_raw\" in name:\n            no_decay.append(param)\n        else:\n            decay.append(param)\n    return [{\"params\": decay, \"weight_decay\": weight_decay}, {\"params\": no_decay, \"weight_decay\": 0.0}]\n\n# ==========================================\n# 6. Main Training Loop\n# ==========================================\ndef main():\n    dist.init_process_group(backend=\"nccl\")\n    local_rank = int(os.environ[\"LOCAL_RANK\"])\n    world_size = int(os.environ[\"WORLD_SIZE\"])\n    torch.cuda.set_device(local_rank)\n    device = torch.device(f\"cuda:{local_rank}\")\n\n    TRAIN_BIN = \"/kaggle/input/datasets/maximusshtefan/patches-pre-shuffled-ubc-ocean/dataset/ubc_train_shuffled.bin\"\n    TRAIN_CSV = \"/kaggle/input/datasets/maximusshtefan/patches-pre-shuffled-ubc-ocean/dataset/ubc_train_shuffled.csv\"\n    VAL_BIN = \"/kaggle/input/datasets/maximusshtefan/patches-pre-shuffled-ubc-ocean/dataset/ubc_ocean_valid.bin\"\n    VAL_CSV = \"/kaggle/input/datasets/maximusshtefan/patches-pre-shuffled-ubc-ocean/dataset/ubc_ocean_valid.csv\"\n    OUTPUT_DIR = \"/kaggle/working/\"\n    RESUME_PATH = None # Set to valid path to execute resumption logic\n\n    # Batch Size may be scaled empirically to VRAM limit based on compilation static sizing\n    BATCH_SIZE = 128\n    \n    train_ds = DistributedUBCDataset(TRAIN_BIN, TRAIN_CSV, local_rank, world_size)\n    val_ds = DistributedUBCDataset(VAL_BIN, VAL_CSV, local_rank, world_size)\n    \n    train_loader = DataLoader(train_ds, batch_size=BATCH_SIZE, num_workers=1, pin_memory=True, drop_last=True)\n    val_loader = DataLoader(val_ds, batch_size=BATCH_SIZE, num_workers=1, pin_memory=True, drop_last=True)\n\n    # ------------------------------------------\n    # Model Initialization & Compilation Warmup\n    # ------------------------------------------\n    model = FSQAutoencoder().to(device)\n    corruptor = HistopathologyCorruptor().to(device)\n    criterion = CombinedReconstructionLoss().to(device)\n    ssim_metric_eval = StatelessSSIM().to(device)\n\n    model = torch.compile(model, dynamic=False, fullgraph=True)\n    corruptor = torch.compile(corruptor, dynamic=False, fullgraph=True)\n\n    # Warmup Phase: Frontload TorchInductor JIT tracing and autotuning.\n    # torch.linspace generates a batch where pixel values smoothly cover [-1, 1], \n    # strictly forcing the compiler to trace all logical paths in torch.where.\n    if local_rank == 0:\n        print(\"Executing Compilation Warmup...\")\n    dummy_in = torch.linspace(-1.0, 1.0, steps=BATCH_SIZE * 3 * 256 * 256, device=device).view(BATCH_SIZE, 3, 256, 256)\n    \n    model.train()\n    for _ in range(5):\n        with torch.amp.autocast('cuda'):\n            dummy_aug = corruptor(dummy_in, noise_std=0.03)\n            dummy_recon, _ = model(dummy_aug)\n            dummy_loss, _, _ = criterion(dummy_recon, dummy_in)\n        # Execute backward pass to compile the autograd graph\n        dummy_loss.backward()\n        # Discard gradients; no optimizer step is taken\n        for param in model.parameters():\n            if param.grad is not None:\n                param.grad = None\n    \n    del dummy_in, dummy_aug, dummy_recon, dummy_loss\n    torch.cuda.empty_cache()\n\n    model = DDP(model, device_ids=[local_rank])\n    ema = EMA(model, decay=0.999)\n\n    optim_groups = get_parameter_groups(model, weight_decay=1e-5)\n    optimizer = torch.optim.AdamW(optim_groups, lr=5e-4)\n    scaler = torch.amp.GradScaler('cuda')\n    \n    # ------------------------------------------\n    # Optimization State Tracking\n    # ------------------------------------------\n    TOTAL_EPOCHS = 50\n    total_steps = len(train_loader) * TOTAL_EPOCHS\n    warmup_steps = int(total_steps * 0.05)\n    \n    scheduler = torch.optim.lr_scheduler.CosineAnnealingWarmRestarts(\n        optimizer, T_0=len(train_loader) * 10, T_mult=1, eta_min=1e-6\n    )\n\n    start_epoch, step = 0, 0\n    best_val_loss = float('inf')\n    \n    if RESUME_PATH is not None and os.path.exists(RESUME_PATH):\n        start_epoch, step, best_val_loss = load_checkpoint(RESUME_PATH, model, ema, optimizer, scaler, device)\n        # Advance scheduler state\n        for _ in range(step):\n            if _ >= warmup_steps: scheduler.step()\n\n    checkpoint_history = []\n    run_loss, run_c, run_s, run_gn = 0.0, 0.0, 0.0, 0.0\n    bin_counts_global = torch.zeros((16, 16), dtype=torch.int64, device=device)\n    log_df, val_log_df = [], []\n\n    # ------------------------------------------\n    # Baseline Output Verification (Step 0)\n    # ------------------------------------------\n    fixed_val_batch = None\n    if local_rank == 0:\n        # Pre-extract identical fixed evaluation batch (respecting dynamic=False)\n        fixed_val_batch = next(iter(val_loader)).to(device, non_blocking=True).to(torch.float32) / 255.0 * 2.0 - 1.0\n        \n        # Save exact un-corrupted subset for visual baseline\n        for i in range(25):\n            torchvision.utils.save_image((fixed_val_batch[i] + 1.0) / 2.0, f\"{OUTPUT_DIR}/original_img_{i}.png\")\n            \n        if step == 0:\n            model.eval()\n            with torch.no_grad():\n                with torch.amp.autocast('cuda'):\n                    init_recon, _ = model(fixed_val_batch)\n            for i in range(25):\n                torchvision.utils.save_image((init_recon[i] + 1.0) / 2.0, f\"{OUTPUT_DIR}/recon_ep_0.0_init_img_{i}.png\")\n\n    # ------------------------------------------\n    # Core Loop\n    # ------------------------------------------\n    for epoch in range(start_epoch, TOTAL_EPOCHS):\n        model.train()\n        for batch_idx, images_uint8 in enumerate(train_loader):\n            x_clean = (images_uint8.to(device, non_blocking=True).to(torch.float32) / 255.0) * 2.0 - 1.0\n            \n            n_corrupt = int(0.80 * BATCH_SIZE)\n            x_in = x_clean.clone()\n            if n_corrupt > 0:\n                x_in[:n_corrupt] = corruptor(x_clean[:n_corrupt], noise_std=0.03)\n\n            optimizer.zero_grad(set_to_none=True)\n            \n            with torch.amp.autocast('cuda'):\n                recon_images, z_q = model(x_in)\n                total_loss, loss_c, loss_s = criterion(recon_images, x_clean)\n            \n            scaler.scale(total_loss).backward()\n            scaler.unscale_(optimizer)\n            grad_norm = torch.nn.utils.clip_grad_norm_(model.parameters(), max_norm=1.0)\n            scaler.step(optimizer)\n            scaler.update()\n            \n            if step < warmup_steps:\n                lr_scale = float(step) / float(max(1, warmup_steps))\n                for pg in optimizer.param_groups:\n                    pg['lr'] = lr_scale * 5e-4\n            else:\n                scheduler.step()\n                \n            ema.update(model)\n            \n            # Extract discrete state assignment (0 to 15) for entropy calculations\n            z_indices = torch.round(((z_q + 1.0) / 2.0) * 15.0).to(torch.int64)\n            for ch in range(16):\n                bin_counts_global[ch] += torch.bincount(z_indices[:, ch, :, :].flatten(), minlength=16)\n\n            run_loss += total_loss.item()\n            run_c += loss_c.item()\n            run_s += loss_s.item()\n            run_gn += grad_norm.item()\n            step += 1\n            \n            is_midpoint = (batch_idx == len(train_loader) // 2)\n            is_endpoint = (batch_idx == len(train_loader) - 1)\n\n            # CSV Logger Aggregation\n            if local_rank == 0 and (step % 60 == 0 or is_endpoint):\n                div = 60 if step % 60 == 0 else (step % 60)\n                s_vals = (2.0 * torch.sigmoid(model.module.fsq.s_raw)).detach().flatten().cpu().numpy()\n                log_df.append({\n                    \"epoch\": epoch, \"step\": step, \n                    \"loss\": run_loss / div, \"charbonnier\": run_c / div, \"dssim\": run_s / div, \n                    \"grad_norm\": run_gn / div, \"s_mean\": s_vals.mean(), \"lr\": optimizer.param_groups[0]['lr']\n                })\n                run_loss, run_c, run_s, run_gn = 0.0, 0.0, 0.0, 0.0\n\n            # Periodic Validation Checkpoint (0.5 Epochs)\n            if is_midpoint or is_endpoint:\n                model.eval()\n                ema.copy_to(model)\n                \n                v_loss_sum, v_mse, v_mae, v_ssim = 0.0, 0.0, 0.0, 0.0\n                \n                with torch.no_grad():\n                    for v_batch in val_loader:\n                        v_clean = (v_batch.to(device).to(torch.float32) / 255.0) * 2.0 - 1.0\n                        with torch.amp.autocast('cuda'):\n                            # Bypassing domain shift noise during validation evaluation\n                            v_in = corruptor(v_clean, noise_std=0.0) \n                            v_recon, _ = model(v_in)\n                            v_loss, _, _ = criterion(v_recon, v_clean)\n                            \n                            v_loss_sum += v_loss.item()\n                            v_mse += F.mse_loss(v_recon, v_clean).item()\n                            v_mae += F.l1_loss(v_recon, v_clean).item()\n                            v_ssim += ssim_metric_eval(v_recon, v_clean).item()\n                \n                metrics_tensor = torch.tensor([\n                    v_loss_sum / len(val_loader), v_mse / len(val_loader), \n                    v_mae / len(val_loader), v_ssim / len(val_loader)\n                ], device=device)\n                \n                dist.all_reduce(metrics_tensor, op=dist.ReduceOp.AVG)\n                g_loss, g_mse, g_mae, g_ssim = metrics_tensor.cpu().numpy()\n                g_psnr = 10.0 * math.log10((2.0 ** 2) / g_mse)\n\n                if local_rank == 0:\n                    fraction = \"5\" if is_midpoint else \"0\"\n                    ep_str = str(epoch) if is_midpoint else str(epoch + 1)\n                    \n                    val_log_df.append({\n                        \"epoch\": epoch, \"fraction\": fraction, \"val_loss\": g_loss, \n                        \"val_mse\": g_mse, \"val_mae\": g_mae, \"val_psnr\": g_psnr, \"val_ssim\": g_ssim\n                    })\n                    \n                    with torch.no_grad():\n                        with torch.amp.autocast('cuda'):\n                            fixed_recon, fixed_zq = model(fixed_val_batch)\n                    \n                    for i in range(25):\n                        torchvision.utils.save_image(\n                            (fixed_recon[i] + 1.0) / 2.0, \n                            f\"{OUTPUT_DIR}/recon_ep_{ep_str}.{fraction}_img_{i}.png\"\n                        )\n                    \n                    pd.DataFrame(log_df).to_csv(f\"{OUTPUT_DIR}/train_log.csv\", index=False)\n                    pd.DataFrame(val_log_df).to_csv(f\"{OUTPUT_DIR}/val_log.csv\", index=False)\n                    np.save(f\"{OUTPUT_DIR}/fsq_bin_histogram_ep_{ep_str}.{fraction}.npy\", bin_counts_global.cpu().numpy())\n                    \n                    ckpt_name = f\"{OUTPUT_DIR}/checkpoint_ep_{ep_str}.{fraction}.pt\"\n                    save_checkpoint(model, ema, optimizer, scaler, epoch, step, g_loss, ckpt_name)\n                    checkpoint_history.append(ckpt_name)\n                    \n                    if len(checkpoint_history) > 4:\n                        os.remove(checkpoint_history.pop(0))\n                        \n                    if g_loss < best_val_loss:\n                        best_val_loss = g_loss\n                        save_checkpoint(model, ema, optimizer, scaler, epoch, step, g_loss, f\"{OUTPUT_DIR}/best_model.pt\")\n                \n                model.train()\n\n    dist.destroy_process_group()\n\nif __name__ == \"__main__\":\n    main()","metadata":{"trusted":true},"outputs":[],"execution_count":null}]}